# Google Drive gallery — copy to .env.local for `npm run dev`,
# and add the same names in Vercel → Project → Settings → Environment Variables.
# Server-side only: never prefix these with VITE_ (that would ship them to browsers).

# Google Cloud API key with the "Google Drive API" enabled
GOOGLE_DRIVE_API_KEY=

# The shared folder's link (or just its ID), shared as "Anyone with the link — Viewer"
GOOGLE_DRIVE_FOLDER=https://drive.google.com/drive/folders/XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: seconds before new/removed photos show up on the site (default 300, min 30)
GALLERY_CACHE_SECONDS=300
